# Copy this file to .env and fill in the keys you have. Every key is optional;
# the app tries them in order and moves on when one is out of free quota.

# Google Gemini (free): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# NVIDIA developer API (free; Llama and Kimi models): https://build.nvidia.com/settings/api-keys
NVIDIA_API_KEY=
# Groq (free; Llama): https://console.groq.com/keys
GROQ_API_KEY=
# Mistral free "Experiment" plan: https://console.mistral.ai
MISTRAL_API_KEY=
# OpenRouter (free models incl. Kimi): https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Cloudflare Workers AI (free daily allowance; Llama): dash.cloudflare.com -> AI -> Workers AI
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# GitHub Models (free): fine-grained token with "Models: read"
GITHUB_MODELS_TOKEN=
# Cerebras (trial credit): https://cloud.cerebras.ai
CEREBRAS_API_KEY=
# Sarvam AI (Indian, strong Bengali; signup credit): https://dashboard.sarvam.ai
SARVAM_API_KEY=
# Kimi K3 official API (paid, $1 minimum top-up): https://platform.kimi.ai
KIMI_API_KEY=

# Optional
# PORT=3000
# PROVIDER_ORDER=gemini,nvidia,groq,mistral,openrouter,cloudflare,github,cerebras,sarvam,kimi
