# Copy this file to .env and fill in the keys you have. Every key is optional.
# The app tries PROVIDER_ORDER and moves on when one fails.
# Paid keys below are NOT used unless you add their name to PROVIDER_ORDER.
# A key in the chain is spent by every visitor to the public site.

# --- Tried automatically when the key is set ---
# Google Gemini (free tier): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# NVIDIA developer API (prototyping only, not a public product): https://build.nvidia.com/settings/api-keys
NVIDIA_API_KEY=
# Groq (free daily quota): https://console.groq.com/keys
GROQ_API_KEY=
# Mistral free plan: https://console.mistral.ai
MISTRAL_API_KEY=
# OpenRouter (:free models, about 50 requests/day): https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Cloudflare Workers AI (10,000 Neurons/day): https://dash.cloudflare.com
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# SambaNova (free, about 20 requests and 200,000 tokens/day per model): https://cloud.sambanova.ai
SAMBANOVA_API_KEY=
# Z.ai GLM Flash, priced $0 (GLM-4.7-Flash): https://z.ai
ZAI_API_KEY=
# Cerebras ($5 trial after a card): https://cloud.cerebras.ai
CEREBRAS_API_KEY=
# Sarvam AI (Indian, strong Bengali; signup credit): https://dashboard.sarvam.ai
SARVAM_API_KEY=
# Kimi K3 official API (paid): https://platform.kimi.ai
KIMI_API_KEY=

# --- Off until named in PROVIDER_ORDER (paid, or a one-time grant that then bills) ---
# Cohere trial, about 1,000 calls/month, not for production: https://dashboard.cohere.com/api-keys
COHERE_API_KEY=
# DeepSeek, no free tier, cheapest way to buy volume: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
# Alibaba Model Studio, Singapore. About 1,000,000 tokens per model once, for 90 days,
# then it bills unless Free Quota Only is on: https://www.alibabacloud.com/help/en/model-studio/new-free-quota
DASHSCOPE_API_KEY=
# OpenAI (prepaid, no free text tier): https://platform.openai.com/api-keys
OPENAI_API_KEY=
# xAI Grok (prepaid): https://console.x.ai
XAI_API_KEY=
# Together (prepaid): https://api.together.ai/settings/api-keys
TOGETHER_API_KEY=
# Fireworks (about $1 starter credit, then paid): https://fireworks.ai/account/api-keys
FIREWORKS_API_KEY=
# GitHub Models was shut down on 30 July 2026. Leave empty.
GITHUB_MODELS_TOKEN=

# Optional
# PORT=3000
# PROVIDER_ORDER=gemini,nvidia,groq,mistral,openrouter,cloudflare,sambanova,zai,cerebras,sarvam,kimi
# Add a paid name only when you mean to spend it, for example:
# PROVIDER_ORDER=gemini,groq,deepseek
# GEMINI_MODELS=gemini-flash-latest,gemini-flash-lite-latest
# NVIDIA_MODELS=meta/llama-3.3-70b-instruct
# GROQ_MODELS=openai/gpt-oss-120b,llama-3.3-70b-versatile
# OPENROUTER_MODELS=nvidia/nemotron-3-ultra-550b-a55b:free
# SAMBANOVA_MODELS=Meta-Llama-3.3-70B-Instruct
# ZAI_MODELS=glm-4.7-flash
# DEEPSEEK_MODELS=deepseek-flash
# QWEN_MODELS=qwen-flash
# XAI_MODELS=grok-4.7
# TOGETHER_MODELS=meta-llama/Llama-3.3-70B-Instruct-Turbo
